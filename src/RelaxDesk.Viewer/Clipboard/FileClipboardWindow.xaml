<Window x:Class="RelaxDesk.Viewer.FileClipboardWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件剪贴板" Width="640" Height="600" MinWidth="480" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="/RelaxDesk.Viewer;component/Themes/ModernTheme.xaml" />
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="文件复制粘贴" FontSize="22" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,14"
                       Text="先在资源管理器复制文件，再在此确认传输。只有全部完成后才准备文件剪贴板；请在对应电脑的资源管理器中自行粘贴。传输使用可见的 RelaxDesk-Clipboard-* 子文件夹，保留文件供粘贴，不自动删除。" />
            <Button x:Name="ReadLocal" Content="读取本机已复制的文件" />
            <TextBlock x:Name="localNames" TextWrapping="Wrap" />
            <Button x:Name="ConfirmUpload" Content="确认上传并准备远端粘贴" IsEnabled="False" />
            <Button x:Name="RetryRemote" Content="再次准备远端粘贴（不重传）" IsEnabled="False" />
            <Separator />
            <TextBlock x:Name="remoteNames" TextWrapping="Wrap" />
            <Button x:Name="ChooseFolder" Content="选择本机接收文件夹" IsEnabled="False" />
            <Button x:Name="ConfirmDownload" Content="确认下载并准备本机粘贴" IsEnabled="False" />
            <Button x:Name="RetryLocal" Content="再次准备本机粘贴（不重传）" IsEnabled="False" />
            <Button x:Name="queue" Content="打开传输进度 / 暂停 / 取消" />
            <Button x:Name="cancel" Content="取消当前剪贴板传输" />
            <TextBlock x:Name="feedback" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
