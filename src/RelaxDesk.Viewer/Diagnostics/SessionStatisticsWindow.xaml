<Window x:Class="RelaxDesk.Viewer.SessionStatisticsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RelaxDesk.SharedUI"
        Title="{ui:Loc Ui.SessionStatisticsWindow.Text043}" Width="620" MinWidth="460"
        SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#F1F5FA"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <ResourceDictionary Source="/RelaxDesk.Viewer;component/Themes/ModernTheme.xaml" />
    </Window.Resources>
    <Border Background="#F1F5FA" Padding="18">
    <StackPanel>
        <Border Background="#17243A" CornerRadius="10" Padding="16,13">
            <StackPanel>
                <TextBlock x:Name="EndpointLabel" Foreground="White" FontSize="17" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Summary" Foreground="#D6E5FA" Margin="0,4,0,0"
                           Text="{ui:Loc Ui.SessionStatisticsWindow.Text364}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Expander x:Name="Details" Header="{ui:Loc Ui.SessionStatisticsWindow.Text449}" IsExpanded="True" Margin="0,12,0,0">
            <Border Background="White" BorderBrush="#D6DFED" BorderThickness="1" CornerRadius="8"
                    Margin="0,8,0,0">
                <ScrollViewer x:Name="ReportScroll" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ReportText" Text="{ui:Loc Ui.SessionStatisticsWindow.Text368}" Foreground="#17243A"
                               TextWrapping="Wrap" Margin="14" FontSize="13" />
                </ScrollViewer>
            </Border>
        </Expander>
        <DockPanel Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{ui:Loc Ui.SessionStatisticsWindow.Text169}" Click="CopyDetails" />
                <Button Content="{ui:Loc Ui.SessionStatisticsWindow.Text394}" MinWidth="86" IsDefault="True" IsCancel="True" Click="CloseDetails"
                        Style="{DynamicResource PrimaryButton}" />
            </StackPanel>
            <TextBlock x:Name="CopyStatus" Text="{ui:Loc Ui.SessionStatisticsWindow.Text023}" Foreground="#475569"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </StackPanel>
    </Border>
</Window>
