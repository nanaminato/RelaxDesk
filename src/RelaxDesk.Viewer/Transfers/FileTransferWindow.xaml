<Window x:Class="RelaxDesk.Viewer.FileTransferWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RelaxDesk · 文件传输" Width="1080" Height="800" MinWidth="820" MinHeight="620"
        FontSize="13" FontFamily="Segoe UI, Microsoft YaHei UI" Background="#F1F5F9" AllowDrop="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RelaxDesk.Viewer;component/Themes/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TransferGrid" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="EnableRowVirtualization" Value="True" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
                <Setter Property="AlternatingRowBackground" Value="#F8FAFD" />
                <Setter Property="RowHeight" Value="25" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
            </Style>
            <Style x:Key="TransferNotice" TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="Background" Value="#E8F2FF" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <Button x:Name="StopFilesButton" DockPanel.Dock="Right" Content="关闭文件权限" />
                <StackPanel>
                    <TextBlock Text="文件传输" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="仅限 Host 授权目录。拖入文件只会显示上传确认；远端应用拖放、剪贴板文件或占位符不在此处理。"
                               TextWrapping="Wrap" Foreground="SlateGray" />
                </StackPanel>
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <Border x:Name="recoveryNotice" Style="{StaticResource TransferNotice}" Margin="0,7,0,4">
                    <StackPanel>
                        <TextBlock x:Name="recoveryText" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button x:Name="ContinueRecoveryButton" Content="继续中断任务" />
                            <Button x:Name="discardRecovery" Content="放弃中断任务" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="breadcrumb" FontWeight="SemiBold" Margin="4,6,4,6" />
                <WrapPanel>
                    <Button x:Name="parent" Content="上级" />
                    <Button x:Name="reload" Content="刷新" />
                    <Button x:Name="uploadFile" Content="上传文件…" />
                    <Button x:Name="uploadFolder" Content="上传文件夹…" />
                    <Button x:Name="download" Content="下载选中…" />
                    <Button x:Name="chooseDestination" Content="下载目录…" />
                    <Button x:Name="previous" Content="上一页" />
                    <Button x:Name="next" Content="下一页" />
                </WrapPanel>
                <Border x:Name="confirmation" Style="{StaticResource TransferNotice}" Margin="0,5,0,6">
                    <StackPanel>
                        <TextBlock x:Name="confirmationText" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button x:Name="ConfirmUploadButton" Content="确认上传" />
                            <Button x:Name="dismiss" Content="取消上传" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <DataGrid x:Name="remote" Grid.Row="2" Style="{StaticResource TransferGrid}" SelectionMode="Extended" MinHeight="130">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90" />
                    <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3" Margin="0,10,0,6">
                <TextBlock x:Name="summary" />
                <ProgressBar x:Name="totalProgress" Height="6" Margin="0,6,0,6" />
                <TextBlock x:Name="feedback" TextWrapping="Wrap" Foreground="SlateGray" />
            </StackPanel>
            <Expander Grid.Row="4" Header="传输队列" IsExpanded="True">
                <DataGrid x:Name="tasks" Style="{StaticResource TransferGrid}" SelectionMode="Single" MinHeight="110">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="55" />
                        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="130" />
                        <DataGridTextColumn Header="进度" Binding="{Binding Progress}" Width="180" />
                        <DataGridTextColumn Header="速度" Binding="{Binding Rate}" Width="100" />
                        <DataGridTextColumn Header="预计剩余" Binding="{Binding Eta}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>
            <StackPanel Grid.Row="5">
                <WrapPanel>
                    <Button x:Name="pause" Content="暂停" />
                    <Button x:Name="cancel" Content="取消" />
                    <Button x:Name="retry" Content="重试" />
                    <Button x:Name="overwrite" Content="覆盖" />
                    <Button x:Name="keepBoth" Content="保留两份" />
                    <Button x:Name="skip" Content="跳过" />
                    <Button x:Name="openFolder" Content="打开本地目录" />
                    <Button x:Name="clear" Content="清除已结束" />
                    <Button x:Name="cancelAll" Content="取消全部" />
                </WrapPanel>
                <TextBlock x:Name="selectedDetail" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
