<Window x:Class="RelaxDesk.Viewer.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:RelaxDesk.Core;assembly=RelaxDesk.Core"
        xmlns:ui="clr-namespace:RelaxDesk.SharedUI"
        Title="{ui:Loc Viewer.WindowTitle}"
        Icon="/RelaxDesk.Viewer;component/Assets/viewer.ico"
        Width="560" Height="480" MinWidth="540" MinHeight="460"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        Background="#F4F7FB" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RelaxDesk.Viewer;component/Themes/ViewerTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FieldRow" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Border x:Name="windowToolbar" DockPanel.Dock="Top" Height="78" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Viewbox Width="40" Height="40" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Grid Width="64" Height="64">
                        <Border CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1D4ED8" Offset="0" />
                                    <GradientStop Color="#0EA5E9" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Width="40" Height="28" VerticalAlignment="Top" Margin="0,13,0,0"
                                CornerRadius="4" Background="#24FFFFFF" BorderBrush="White" BorderThickness="3">
                            <Path Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 10,16 L 24,6 M 16,6 L 24,6 L 24,14" />
                        </Border>
                        <Border Width="3" Height="7" VerticalAlignment="Bottom" Margin="0,0,0,15" Background="White" CornerRadius="1.5" />
                        <Border Width="20" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,13" Background="White" CornerRadius="1.5" />
                    </Grid>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="RelaxDesk" FontSize="22" FontWeight="Bold" Foreground="#0F172A"
                               ToolTip="{x:Static core:BuildIdentity.Display}" />
                    <TextBlock Text="{ui:Loc Viewer.WindowTitle}" FontSize="11" Foreground="#64748B" Margin="0,1,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel x:Name="connectionFooter" DockPanel.Dock="Bottom">
            <Separator />
            <DockPanel Margin="14,9,14,10">
                <Button x:Name="optionsButton" Content="{ui:Loc Viewer.ShowOptions}" MinWidth="96" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="disconnect" Content="{ui:Loc Viewer.CancelConnection}" IsEnabled="False" Visibility="Collapsed" />
                    <Button x:Name="connect" Content="{ui:Loc Viewer.Connect}" IsDefault="True" MinWidth="88" />
                    <Button x:Name="cancelConnection" Content="{ui:Loc Common.Cancel}" MinWidth="82" />
                </StackPanel>
            </DockPanel>
            <StackPanel Margin="18,0,18,10">
                <TextBlock x:Name="status" TextWrapping="Wrap" Foreground="DimGray" FontSize="11" />
                <Expander x:Name="errorDetails" Header="{ui:Loc Viewer.ErrorDetails}" Visibility="Collapsed" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBox x:Name="errorReport" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="190"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                        <WrapPanel>
                            <Button x:Name="copyError" Content="{ui:Loc Viewer.CopyDiagnostics}" ToolTip="{ui:Loc Viewer.CopyDiagnosticsTip}" />
                            <Button x:Name="clearError" Content="{ui:Loc Viewer.ClearDetails}" />
                        </WrapPanel>
                        <TextBlock x:Name="copyErrorFeedback" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </StackPanel>
        <Grid x:Name="renderPanel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="videoPanel" ClipToBounds="True">
                    <Canvas x:Name="bitmapPanel">
                        <Image x:Name="image" Stretch="Fill" Focusable="True" HorizontalAlignment="Left" VerticalAlignment="Top" />
                    </Canvas>
                    <Border x:Name="displayUnavailable" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="480" Padding="24" Background="White" CornerRadius="10">
                        <TextBlock TextWrapping="Wrap" Foreground="DimGray"><Run Text="{ui:Loc Viewer.DisplayUnavailableTitle}" /><LineBreak /><LineBreak /><Run Text="{ui:Loc Viewer.DisplayUnavailableBody}" /></TextBlock>
                    </Border>
                </Grid>
                <ScrollBar x:Name="horizontalPan" Grid.Row="1" Orientation="Horizontal" Height="12" Visibility="Collapsed" />
                <ScrollBar x:Name="verticalPan" Grid.Column="1" Orientation="Vertical" Width="12" Visibility="Collapsed" />
            </Grid>
            <ScrollViewer x:Name="connectionOverlay" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border x:Name="connectionCard" Grid.IsSharedSizeScope="True" Margin="10,8,10,0">
                    <Grid>
                        <Border x:Name="basicConnection">
                            <StackPanel x:Name="signInForm" Margin="20,14,20,8">
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="88" SharedSizeGroup="ConnectionLabel" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Label Style="{StaticResource FieldLabel}" Content="{ui:Loc Viewer.Computer}" Target="{Binding ElementName=host}" />
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="82" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="host" Text="192.168.1.10" />
                                        <TextBlock Grid.Column="1" Text="{ui:Loc Common.Port}" VerticalAlignment="Center" Margin="10,0,7,0" />
                                        <TextBox x:Name="port" Grid.Column="2" Text="48200" />
                                    </Grid>
                                </Grid>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="88" SharedSizeGroup="ConnectionLabel" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Label Style="{StaticResource FieldLabel}" Content="{ui:Loc Viewer.UserName}" Target="{Binding ElementName=loginName}" />
                                    <TextBox x:Name="loginName" Grid.Column="1" MaxLength="{x:Static core:PasswordVerifier.MaximumUserNameLength}" />
                                </Grid>
                                <Grid Style="{StaticResource FieldRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="88" SharedSizeGroup="ConnectionLabel" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Label Style="{StaticResource FieldLabel}" Content="{ui:Loc Viewer.Password}" Target="{Binding ElementName=token}" />
                                    <PasswordBox x:Name="token" Grid.Column="1" />
                                </Grid>
                                <CheckBox x:Name="rememberCredentials" Content="{ui:Loc Viewer.RememberCredentials}" Margin="88,4,0,7"
                                          ToolTip="{ui:Loc Viewer.RememberCredentialsTip}" />
                                <TextBlock Text="{ui:Loc Viewer.FirstConnectHint}" Foreground="DimGray" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,4" />
                                <Expander x:Name="connectionHistoryPanel" Header="{ui:Loc Viewer.RecentConnections}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <ComboBox x:Name="recentConnections" MinHeight="30" />
                                        <WrapPanel>
                                            <CheckBox x:Name="rememberConnections" Content="{ui:Loc Viewer.RememberConnections}" ToolTip="{ui:Loc Viewer.RememberConnectionsTip}" IsChecked="True" />
                                            <Button x:Name="clearConnections" Content="{ui:Loc Viewer.ClearHistory}" />
                                        </WrapPanel>
                                        <TextBlock x:Name="historyNotice" TextWrapping="Wrap" FontSize="11" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <TabControl x:Name="connectionOptions" Visibility="Collapsed">
                            <TabItem x:Name="generalTab" Header="{ui:Loc Viewer.TabGeneral}" />
                            <TabItem Header="{ui:Loc Viewer.TabDisplay}">
                                <StackPanel Margin="18">
                                    <CheckBox x:Name="startFullScreen" Content="{ui:Loc Viewer.StartFullScreen}" IsChecked="True" />
                                    <CheckBox x:Name="gpuRendering" Content="{ui:Loc Viewer.GpuRendering}" ToolTip="{ui:Loc Viewer.GpuRenderingTip}" IsChecked="True" />
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="{ui:Loc Viewer.TabAdvanced}">
                                <StackPanel Margin="18">
                                    <Grid Style="{StaticResource FieldRow}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="88" SharedSizeGroup="ConnectionLabel" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Label Style="{StaticResource FieldLabel}" Content="{ui:Loc Viewer.FrameRateLimit}" Target="{Binding ElementName=videoFrameRate}" />
                                        <ComboBox x:Name="videoFrameRate" Grid.Column="1" SelectedValuePath="Tag" />
                                    </Grid>
                                    <Grid Style="{StaticResource FieldRow}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="88" SharedSizeGroup="ConnectionLabel" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Label Style="{StaticResource FieldLabel}" Content="{ui:Loc Viewer.VideoBitrate}" Target="{Binding ElementName=videoBitrate}" />
                                        <ComboBox x:Name="videoBitrate" Grid.Column="1" SelectedValuePath="Tag" />
                                    </Grid>
                                    <CheckBox x:Name="autoConnectionQuality" Content="{ui:Loc Viewer.AutomaticQuality}" ToolTip="{ui:Loc Viewer.AutomaticQualityTip}" Margin="0,0,0,12" />
                                    <Grid Style="{StaticResource FieldRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="88" SharedSizeGroup="ConnectionLabel" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Label Style="{StaticResource FieldLabel}" Content="{ui:Loc Viewer.MediaTransport}" Target="{Binding ElementName=networkMode}" />
                                        <ComboBox x:Name="networkMode" Grid.Column="1" SelectedIndex="0" SelectedValuePath="Content">
                                            <ComboBoxItem Content="{ui:Loc Common.Automatic}" />
                                            <ComboBoxItem Content="TCP" />
                                            <ComboBoxItem Content="UDP" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid Style="{StaticResource FieldRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="88" SharedSizeGroup="ConnectionLabel" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Label Style="{StaticResource FieldLabel}" Content="{ui:Loc Viewer.FileRateLimit}" Target="{Binding ElementName=fileRateLimit}" />
                                        <ComboBox x:Name="fileRateLimit" Grid.Column="1" SelectedIndex="0">
                                            <ComboBoxItem Content="{ui:Loc Viewer.FileRateDefault}" />
                                            <ComboBoxItem Content="4 MiB/s" />
                                            <ComboBoxItem Content="1 MiB/s" />
                                            <ComboBoxItem Content="256 KiB/s" />
                                            <ComboBoxItem Content="50 MiB/s" />
                                            <ComboBoxItem Content="100 MiB/s" />
                                            <ComboBoxItem Content="250 MiB/s" />
                                            <ComboBoxItem Content="{ui:Loc Viewer.FileRateUnlimited}" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid Style="{StaticResource FieldRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="88" SharedSizeGroup="ConnectionLabel" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Label Style="{StaticResource FieldLabel}" Content="{ui:Loc Common.Language}" Target="{Binding ElementName=languageSelector}" />
                                        <ComboBox x:Name="languageSelector" Grid.Column="1" DisplayMemberPath="DisplayName" SelectedValuePath="Code"
                                                  ToolTip="{ui:Loc Common.LanguageHint}" />
                                    </Grid>
                                    <Button x:Name="resetPin" Content="{ui:Loc Viewer.ResetPin}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </ScrollViewer>
            <StackPanel Visibility="Collapsed">
                <TextBox x:Name="fingerprint" />
                <TextBox x:Name="invitation" />
                <CheckBox x:Name="pinnedConnection" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
