<Window x:Class="RelaxDesk.Viewer.SessionToolbar" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RelaxDesk.SharedUI"
        xmlns:core="clr-namespace:RelaxDesk.Core;assembly=RelaxDesk.Core"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Background="Transparent" AllowsTransparency="True" Focusable="False">
    <Window.Resources>
        <Style x:Key="BarButton" TargetType="ButtonBase">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#447EAE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#164871" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToggleButton" BasedOn="{StaticResource BarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#164871" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#447EAE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#205B8F" CornerRadius="0,0,5,5" BorderBrush="#567EB8" BorderThickness="1,0,1,1" ClipToBounds="True">
        <Border.Tag>
            <ContextMenu x:Name="ShortcutMenu" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
                <MenuItem x:Name="remoteKeys" Header="{ui:Loc Ui.SessionToolbar.Text476}">
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text166}" Tag="{x:Static core:RemoteShortcut.Copy}" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text415}" Tag="{x:Static core:RemoteShortcut.Paste}" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text134}" Tag="{x:Static core:RemoteShortcut.Cut}" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text117}" Tag="{x:Static core:RemoteShortcut.SelectAll}" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text244}" Tag="{x:Static core:RemoteShortcut.Undo}" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text500}" Tag="{x:Static core:RemoteShortcut.Redo}" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text097}" Tag="{x:Static core:RemoteShortcut.Save}" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text342}" Tag="{x:Static core:RemoteShortcut.Find}" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text160}" Tag="{x:Static core:RemoteShortcut.AddressBar}" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text086}" Tag="{x:Static core:RemoteShortcut.TaskManager}" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text125}" Tag="{x:Static core:RemoteShortcut.CloseWindow}" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text129}" Tag="{x:Static core:RemoteShortcut.SwitchWindow}" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text277}" Tag="{x:Static core:RemoteShortcut.Explorer}" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text303}" Tag="{x:Static core:RemoteShortcut.Desktop}" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text470}" Tag="{x:Static core:RemoteShortcut.Run}" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="textInput" Header="{ui:Loc Ui.SessionToolbar.Text334}" IsEnabled="False" />
                <MenuItem x:Name="displays" Header="{ui:Loc Ui.SessionToolbar.Text299}" IsEnabled="False" />
                <MenuItem x:Name="zoom" Header="{ui:Loc Ui.SessionToolbar.Text387}">
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text490}" Tag="0" IsCheckable="True" />
                    <MenuItem Header="50%" Tag="50" IsCheckable="True" />
                    <MenuItem Header="75%" Tag="75" IsCheckable="True" />
                    <MenuItem Header="{ui:Loc Ui.SessionToolbar.Text021}" Tag="100" IsCheckable="True" />
                    <MenuItem Header="125%" Tag="125" IsCheckable="True" />
                    <MenuItem Header="150%" Tag="150" IsCheckable="True" />
                    <MenuItem Header="200%" Tag="200" IsCheckable="True" />
                    <MenuItem Header="300%" Tag="300" IsCheckable="True" />
                    <MenuItem Header="400%" Tag="400" IsCheckable="True" />
                    <Separator />
                    <MenuItem StaysOpenOnClick="True">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{ui:Loc Ui.SessionToolbar.Text435}" VerticalAlignment="Center" />
                                <TextBox x:Name="customZoom" Width="60" MaxLength="3" />
                                <Button x:Name="applyCustomZoom" Content="{ui:Loc Ui.SessionToolbar.Text228}" Padding="8,2,8,2" Style="{x:Null}" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                </MenuItem>
                <MenuItem x:Name="audio" Header="{ui:Loc Ui.SessionToolbar.Text165}" IsEnabled="False" />
                <MenuItem x:Name="statistics" Header="{ui:Loc Ui.SessionToolbar.Text489}" IsEnabled="False" />
                <MenuItem x:Name="videoSettings" Header="{ui:Loc Ui.SessionToolbar.Text444}" IsEnabled="False" />
            </ContextMenu>
        </Border.Tag>
        <DockPanel x:Name="bar">
            <ToggleButton x:Name="pin" DockPanel.Dock="Left" Content="&#xE718;" ToolTip="{ui:Loc Ui.SessionToolbar.Text157}" automation:AutomationProperties.Name="{ui:Loc Ui.SessionToolbar.Text157}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ShortcutsButton" Content="&#xE712;" ToolTip="{ui:Loc Ui.SessionToolbar.Text091}" automation:AutomationProperties.Name="{ui:Loc Ui.SessionToolbar.Text091}" />
                <Button x:Name="minimize" Content="&#xE921;" ToolTip="{ui:Loc Ui.SessionToolbar.Text306}" automation:AutomationProperties.Name="{ui:Loc Ui.SessionToolbar.Text306}" />
                <Button x:Name="full" Content="&#xE922;" ToolTip="{ui:Loc Ui.SessionToolbar.Text128}" automation:AutomationProperties.Name="{ui:Loc Ui.SessionToolbar.Text116}" />
                <Button x:Name="DisconnectButton" Content="&#xE8BB;" ToolTip="{ui:Loc Viewer.Disconnect}" automation:AutomationProperties.Name="{ui:Loc Viewer.Disconnect}" />
            </StackPanel>
            <Border x:Name="dragRegion" Background="Transparent" Cursor="SizeWE" ToolTip="{ui:Loc Ui.SessionToolbar.Text190}">
                <TextBlock x:Name="endpoint" Foreground="White" VerticalAlignment="Center" Margin="8,0" MaxWidth="280"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center" />
            </Border>
        </DockPanel>
    </Border>
</Window>
