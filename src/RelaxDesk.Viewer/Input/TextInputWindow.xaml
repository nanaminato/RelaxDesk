<Window x:Class="RelaxDesk.Viewer.TextInputWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RelaxDesk.SharedUI"
        xmlns:core="clr-namespace:RelaxDesk.Core;assembly=RelaxDesk.Core"
        Title="{ui:Loc Ui.TextInputWindow.Text144}" Width="480" Height="360" MinWidth="360" MinHeight="320"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="/RelaxDesk.Viewer;component/Themes/ModernTheme.xaml" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="hint" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="{ui:Loc Ui.TextInputWindow.Text095}" />
        <TextBox x:Name="Editor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 MinHeight="90" MaxLength="{x:Static core:InputProtocol.MaximumTextUnits}" VerticalScrollBarVisibility="Auto" />
        <Button x:Name="Submit" Grid.Row="2" Content="{ui:Loc Ui.TextInputWindow.Text143}" IsEnabled="False" Margin="0,12,0,0" />
    </Grid>
</Window>
