<UserControl x:Class="RelaxDesk.HostShell.HostDisplaySettings" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="共享屏幕" FontSize="12" Margin="0,0,0,4" />
        <ComboBox x:Name="Choice" MinHeight="32" SelectedIndex="0">
            <ComboBoxItem Content="主显示器" />
        </ComboBox>
        <TextBlock x:Name="Hint" Text="选择共享范围；旋转屏和全部屏幕使用兼容捕获。" TextWrapping="Wrap" />
        <Button x:Name="Refresh" Content="刷新屏幕" />
    </StackPanel>
</UserControl>
