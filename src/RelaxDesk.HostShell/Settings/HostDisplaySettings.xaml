<UserControl x:Class="RelaxDesk.HostShell.HostDisplaySettings" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="共享屏幕" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" />
        <DockPanel>
            <Button x:Name="Refresh" DockPanel.Dock="Right" Content="刷新屏幕" Margin="10,0,0,0" Padding="14,7" VerticalAlignment="Center" />
            <ComboBox x:Name="Choice" MinHeight="34" Padding="10,6" VerticalContentAlignment="Center" SelectedIndex="0">
                <ComboBoxItem Content="主显示器" />
            </ComboBox>
        </DockPanel>
        <TextBlock x:Name="Hint" Text="选择共享范围；旋转屏和全部屏幕使用兼容捕获。"
                   TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
