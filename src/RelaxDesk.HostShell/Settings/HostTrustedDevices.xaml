<UserControl x:Class="RelaxDesk.HostShell.HostTrustedDevices" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="/RelaxDesk.HostShell;component/Themes/ModernTheme.xaml" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="受信任的设备" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
        <TextBlock Text="已信任的设备可使用密码无人值守连接此电脑，或跳过首次设备指纹确认。"
                   TextWrapping="Wrap" FontSize="13" Foreground="#64748B" Margin="0,4,0,16" />

        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="8">
            <ListBox x:Name="Devices" BorderThickness="0" Background="Transparent"
                     MinHeight="170" MaxHeight="260" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="12">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Foreground" Value="#1E293B" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F8FAFC" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#EFF6FF" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD" />
                                            <Setter Property="Foreground" Value="#1E3A8A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <WrapPanel Margin="0,14,0,0">
            <Button x:Name="RememberConnected" Content="信任当前连接的设备" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,4,10,4" />
            <Button x:Name="Forget" Content="撤销所选设备" Style="{StaticResource DangerButton}" IsEnabled="False" Margin="0,4,0,4" />
        </WrapPanel>

        <TextBlock x:Name="Notice" TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="0,10,0,0" />
    </StackPanel>
</UserControl>
