<UserControl x:Class="RelaxDesk.HostShell.HostLoginSettings" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RelaxDesk.SharedUI"
             xmlns:core="clr-namespace:RelaxDesk.Core;assembly=RelaxDesk.Core">
    <StackPanel>
        <TextBlock x:Name="UserNameLabel" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
        <TextBox x:Name="UserName" MaxLength="{x:Static core:PasswordVerifier.MaximumUserNameLength}" />
        <TextBlock x:Name="PasswordLabel" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
        <PasswordBox x:Name="Password" MaxLength="{x:Static core:PasswordVerifier.MaximumPasswordLength}" />
        <Button x:Name="Save" Content="{ui:Loc Ui.HostLoginSettings.Text098}" />
        <TextBlock x:Name="Notice" TextWrapping="Wrap" />
        <TextBlock Text="{ui:Loc Ui.HostLoginSettings.Text149}" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="Fingerprint" Text="{ui:Loc Ui.HostLoginSettings.Text230}" TextWrapping="Wrap" IsReadOnly="True" />
    </StackPanel>
</UserControl>
