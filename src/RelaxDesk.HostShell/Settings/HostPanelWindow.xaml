<Window x:Class="RelaxDesk.HostShell.HostPanelWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/RelaxDesk.HostShell;component/Assets/host.ico"
        Width="660" Height="490" MinWidth="460" MinHeight="320"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="#F4F7FB" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary Source="/RelaxDesk.HostShell;component/Themes/ModernTheme.xaml" />
    </Window.Resources>
    <Border Padding="24,20" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
    </Border>
</Window>
