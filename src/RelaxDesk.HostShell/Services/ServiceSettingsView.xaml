<UserControl x:Class="RelaxDesk.HostShell.ServiceSettingsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RelaxDesk.SharedUI">
    <UserControl.Resources>
        <ResourceDictionary Source="/RelaxDesk.HostShell;component/Themes/ModernTheme.xaml" />
    </UserControl.Resources>
    <StackPanel>
        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12">
            <StackPanel>
                <TextBlock x:Name="CoordinationStatus" Text="{ui:Loc Ui.ServiceSettingsView.Text187}"
                           TextWrapping="Wrap" FontSize="13" Foreground="#1E293B" FontWeight="Medium" />
                <TextBlock x:Name="Installation" Text="{ui:Loc Ui.ServiceSettingsView.Text185}"
                           TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
            <Button x:Name="EnableService" Content="{ui:Loc Ui.ServiceSetupUi.Text156}" Style="{StaticResource PrimaryButton}" Margin="0,4,8,4" />
            <Button x:Name="ConnectService" Content="{ui:Loc Ui.ServiceSettingsView.Text488}" IsEnabled="False" Margin="0,4,8,4" />
            <Button x:Name="RefreshService" Content="{ui:Loc Ui.ServiceSettingsView.Text133}" Margin="0,4,0,4" />
        </WrapPanel>

        <CheckBox x:Name="UseService" Content="{ui:Loc Ui.ServiceSettingsView.Text096}"
                  Margin="0,10,0,0" Foreground="#334155" FontSize="13" />

        <Border Height="1" Background="#E2E8F0" Margin="0,14,0,14" />

        <TextBlock Text="{ui:Loc Ui.ServiceSettingsView.Text154}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6" />
        <ComboBox x:Name="Startup" SelectedIndex="0" MinWidth="260" MinHeight="34" Padding="10,6"
                  VerticalContentAlignment="Center" HorizontalAlignment="Left">
            <ComboBoxItem Content="{ui:Loc Ui.ServiceSettingsView.Text101}" />
            <ComboBoxItem Content="{ui:Loc Ui.ServiceSettingsView.Text235}" />
            <ComboBoxItem Content="{ui:Loc Ui.ServiceSettingsView.Text232}" />
        </ComboBox>

        <WrapPanel Margin="0,10,0,0">
            <Button x:Name="InstallService" Content="{ui:Loc Ui.ServiceSettingsView.Text173}" Margin="0,4,8,4" />
            <Button x:Name="UninstallService" Content="{ui:Loc Ui.ServiceSettingsView.Text141}" Style="{StaticResource DangerButton}" Margin="0,4,0,4" />
        </WrapPanel>

        <TextBlock x:Name="Progress" TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,10,0,0"
                   Text="{ui:Loc Ui.ServiceSettingsView.Text431}" />
    </StackPanel>
</UserControl>
