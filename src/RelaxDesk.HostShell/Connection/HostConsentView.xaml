<UserControl x:Class="RelaxDesk.HostShell.HostConsentView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RelaxDesk.SharedUI">
    <StackPanel>
        <TextBlock Text="{ui:Loc Ui.HostConsentView.Text310}" FontSize="19" FontWeight="SemiBold" Foreground="#17243A" Margin="0,0,0,4" />
        <TextBlock x:Name="Peer" FontSize="16" Margin="0,10,0,8" />
        <TextBlock x:Name="Access" TextWrapping="Wrap" Foreground="SlateGray" />
        <CheckBox x:Name="RememberDevice" Content="{ui:Loc Ui.HostConsentView.Text104}" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="Allow" Content="{ui:Loc Ui.HostConsentView.Text114}" />
            <Button x:Name="Deny" Content="{ui:Loc Ui.HostConsentView.Text241}" />
        </StackPanel>
    </StackPanel>
</UserControl>
