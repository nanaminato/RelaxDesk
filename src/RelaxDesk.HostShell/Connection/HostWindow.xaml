<Window x:Class="RelaxDesk.HostShell.HostWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RelaxDesk.SharedUI"
        Title="{ui:Loc Host.WindowTitle}" Width="900" Height="650" MinWidth="720" MinHeight="520"
        FontSize="14" FontFamily="Segoe UI, Microsoft YaHei UI" Background="#F1F5FA">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RelaxDesk.HostShell;component/Themes/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <TextBox x:Key="HostLogPanel" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     MaxHeight="180" FontFamily="Consolas" FontSize="11" />
            <Style x:Key="HostCard" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="22" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#17243A" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="Overview" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="SlateGray" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Background="#142238">
            <StackPanel Margin="24,28,20,24">
                <TextBlock Text="RelaxDesk" FontSize="26" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="{ui:Loc Host.RoleSubtitle}" Foreground="#A8B8D0" Margin="0,4,0,0" />
                <StackPanel x:Name="Navigation" Margin="0,24,0,0">
                    <Button x:Name="connectionNavigation" Content="{ui:Loc Host.NavConnection}" Margin="0,8,0,0" />
                    <Button x:Name="settingsNavigation" Content="{ui:Loc Host.NavSettings}" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
        <ScrollViewer x:Name="MainScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24">
                <TextBlock x:Name="PageTitle" Text="{ui:Loc Host.PageTitleSharing}" FontSize="28" FontWeight="SemiBold" Foreground="#17243A" />
                <TextBlock x:Name="BuildVersion" FontSize="11" Foreground="SlateGray"
                           Margin="0,5,0,18" TextWrapping="Wrap" />
                <StackPanel x:Name="SharingContent">
                    <Border Style="{StaticResource HostCard}">
                        <StackPanel>
                            <TextBlock x:Name="state" Style="{StaticResource SectionTitle}" FontSize="19" Text="{ui:Loc Host.StateNotSharing}" />
                            <TextBlock x:Name="detail" Text="{ui:Loc Host.DetailChooseAddress}" Style="{StaticResource Overview}" Margin="0,4,0,0" />
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="{ui:Loc Host.SystemService}" Style="{StaticResource SectionTitle}" FontSize="14" />
                                <TextBlock Style="{StaticResource Overview}" Text="{Binding Text, ElementName=serviceOverview}" />
                                <TextBlock Margin="0,4,0,0"><Hyperlink x:Name="serviceLink"><Run Text="{ui:Loc Host.ConfigureSystemService}" /></Hyperlink></TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource HostCard}">
                        <StackPanel>
                            <TextBlock Text="{ui:Loc Host.ConnectionInfo}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{ui:Loc Host.ConnectionInfoHint}" Style="{StaticResource Overview}" FontSize="12" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="135" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:Loc Host.LocalLanIp}" FontSize="12" Margin="0,0,0,4" />
                                    <TextBox x:Name="ip" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{ui:Loc Common.Port}" FontSize="12" Margin="0,0,0,4" />
                                    <TextBox x:Name="port" Text="48200" />
                                </StackPanel>
                            </Grid>
                            <WrapPanel x:Name="addressChoices" />
                            <WrapPanel><Button x:Name="start" Content="{ui:Loc Host.StartSharing}" /></WrapPanel>
                            <TextBlock Margin="4,8,0,0"><Hyperlink x:Name="loginLink"><Run Text="{ui:Loc Host.ConfigureLogin}" /></Hyperlink></TextBlock>
                            <TextBlock x:Name="color" Text="{ui:Loc Host.ColorAndEncryption}" Style="{StaticResource Overview}" Margin="4,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="SettingsContent" Visibility="Collapsed">
                    <Border Style="{StaticResource HostCard}">
                        <DockPanel>
                            <ComboBox x:Name="languageSelector" DockPanel.Dock="Right" MinWidth="160" VerticalAlignment="Center"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Code" ToolTip="{ui:Loc Common.LanguageHint}" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{ui:Loc Host.LanguageSection}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{ui:Loc Host.LanguageOverview}" Style="{StaticResource Overview}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource HostCard}">
                        <DockPanel>
                            <Button x:Name="openDisplay" DockPanel.Dock="Right" Content="{ui:Loc Common.OpenSettings}" VerticalAlignment="Center" AutomationProperties.Name="打开共享设置" />
                            <StackPanel>
                                <TextBlock Text="{ui:Loc Host.SharingSettings}" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="displayOverview" Text="{ui:Loc Host.PrimaryDisplay}" Style="{StaticResource Overview}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border x:Name="loginSection" Style="{StaticResource HostCard}">
                        <DockPanel>
                            <Button x:Name="openLogin" DockPanel.Dock="Right" Content="{ui:Loc Common.OpenSettings}" VerticalAlignment="Center" AutomationProperties.Name="打开登录设置" />
                            <StackPanel>
                                <TextBlock Text="{ui:Loc Host.LoginSettings}" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="loginOverview" Text="{ui:Loc Host.LoadingLoginSettings}" Style="{StaticResource Overview}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border x:Name="serviceSection" Style="{StaticResource HostCard}">
                        <DockPanel>
                            <Button x:Name="openService" DockPanel.Dock="Right" Content="{ui:Loc Common.OpenSettings}" VerticalAlignment="Center" AutomationProperties.Name="打开系统服务" />
                            <StackPanel>
                                <TextBlock Text="{ui:Loc Host.SystemService}" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="serviceOverview" Text="{ui:Loc Host.CheckingSystemService}" Style="{StaticResource Overview}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource HostCard}">
                        <DockPanel>
                            <Button x:Name="openDevices" DockPanel.Dock="Right" Content="{ui:Loc Common.OpenSettings}" VerticalAlignment="Center" AutomationProperties.Name="打开受信任的设备" />
                            <StackPanel>
                                <TextBlock Text="{ui:Loc Host.TrustedDevices}" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="deviceOverview" Text="{ui:Loc Host.LoadingDevices}" Style="{StaticResource Overview}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource HostCard}">
                        <DockPanel>
                            <Button x:Name="openLogs" DockPanel.Dock="Right" Content="{ui:Loc Common.View}" VerticalAlignment="Center" AutomationProperties.Name="打开诊断与日志" />
                            <TextBlock Text="{ui:Loc Host.DiagnosticsAndLogs}" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
