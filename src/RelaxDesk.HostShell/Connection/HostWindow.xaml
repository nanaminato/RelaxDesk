<Window x:Class="RelaxDesk.HostShell.HostWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RelaxDesk.HostShell"
        xmlns:ui="clr-namespace:RelaxDesk.SharedUI"
        Title="{ui:Loc Host.WindowTitle}"
        Icon="/RelaxDesk.HostShell;component/Assets/host.ico"
        Width="940" Height="670" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        FontSize="14" FontFamily="Segoe UI, Microsoft YaHei UI" Background="#F4F7FB" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RelaxDesk.HostShell;component/Themes/ModernTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <TextBox x:Key="HostLogPanel" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     MinHeight="300" MaxHeight="440" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                     Background="#0F172A" Foreground="#E2E8F0" BorderBrush="#1E293B" Padding="14,12" Margin="0" />
            <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.06" />
            <Style x:Key="HostCard" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="24,20" />
                <Setter Property="Margin" Value="0,0,0,16" />
                <Setter Property="Effect" Value="{StaticResource CardShadow}" />
            </Style>
            <Style x:Key="SubPanel" TargetType="Border">
                <Setter Property="Background" Value="#F8FAFC" />
                <Setter Property="BorderBrush" Value="#E2E8F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,12" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#0F172A" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#475569" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="Overview" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="#64748B" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <!-- Left Sidebar -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0F172A" Offset="0" />
                    <GradientStop Color="#14233C" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="20,24,20,18">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="38" Height="38" Margin="0,0,12,0">
                            <Grid Width="64" Height="64">
                                <Border CornerRadius="15" BorderBrush="#40FFFFFF" BorderThickness="1.5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                            <GradientStop Color="#1D4ED8" Offset="0" />
                                            <GradientStop Color="#2563EB" Offset="0.52" />
                                            <GradientStop Color="#0EA5E9" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border Width="40" Height="27" VerticalAlignment="Top" Margin="0,13,0,0"
                                        CornerRadius="5" Background="#28FFFFFF" BorderBrush="White" BorderThickness="3">
                                    <Grid>
                                        <Ellipse Width="7" Height="7" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Path Stroke="#E0F2FE" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M 10,6 A 7,7 0 0 0 10,15 M 24,6 A 7,7 0 0 1 24,15" />
                                    </Grid>
                                </Border>
                                <Border Width="18" Height="3.5" VerticalAlignment="Bottom" Margin="0,0,0,13" Background="White" CornerRadius="1.75" />
                            </Grid>
                        </Viewbox>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RelaxDesk" FontSize="20" FontWeight="Bold" Foreground="White" />
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,3,0,0">
                                <TextBlock Text="{ui:Loc Host.RoleSubtitle}" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="#1E293B" Margin="0,20,0,14" />

                    <StackPanel x:Name="Navigation">
                        <Button x:Name="connectionNavigation" Content="{ui:Loc Host.NavConnection}" Style="{StaticResource NavButtonActive}" />
                        <Button x:Name="settingsNavigation" Content="{ui:Loc Host.NavSettings}" Style="{StaticResource NavButton}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="BuildVersion" DockPanel.Dock="Bottom" FontSize="11" Foreground="#64748B"
                           TextWrapping="Wrap" VerticalAlignment="Bottom" />
            </DockPanel>
        </Border>

        <!-- Right Main Content -->
        <ScrollViewer x:Name="MainScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,26,32,28" MaxWidth="760">
                <TextBlock x:Name="PageTitle" TextWrapping="Wrap" Text="{ui:Loc Host.PageTitleSharing}" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,18" />

                <StackPanel x:Name="SharingContent">
                    <!-- Status Hero Card -->
                    <Border Style="{StaticResource HostCard}">
                        <StackPanel>
                            <DockPanel VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="#3B82F6" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="state" TextWrapping="Wrap" Style="{StaticResource SectionTitle}" FontSize="20" Margin="0" Text="{ui:Loc Host.StateNotSharing}" />
                            </DockPanel>
                            <TextBlock x:Name="detail" Text="{ui:Loc Host.DetailChooseAddress}" Style="{StaticResource Overview}" Margin="20,6,0,0" />

                            <Border Style="{StaticResource SubPanel}" Margin="0,16,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="13" FontWeight="SemiBold">
                                        <Hyperlink x:Name="serviceLink"><Run Text="{ui:Loc Host.ConfigureSystemService}" /></Hyperlink>
                                    </TextBlock>
                                    <StackPanel>
                                        <TextBlock Text="{ui:Loc Host.SystemService}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" />
                                        <TextBlock Style="{StaticResource Overview}" FontSize="12" Margin="0,2,0,0" Text="{Binding Text, ElementName=serviceOverview}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Connection Info Card -->
                    <Border Style="{StaticResource HostCard}">
                        <StackPanel>
                            <TextBlock Text="{ui:Loc Host.ConnectionInfo}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{ui:Loc Host.ConnectionInfoHint}" Style="{StaticResource Overview}" FontSize="12" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="{ui:Loc Host.LocalLanIp}" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ip" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{ui:Loc Common.Port}" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="port" Text="48200" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel x:Name="addressChoices" Margin="0,0,0,8" />

                            <DockPanel Margin="0,4,0,0">
                                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <Button x:Name="start" Content="{ui:Loc Host.StartSharing}" Margin="0,4,12,4" />
                                </WrapPanel>
                                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold">
                                    <Hyperlink x:Name="loginLink"><Run Text="{ui:Loc Host.ConfigureLogin}" /></Hyperlink>
                                </TextBlock>
                            </DockPanel>

                            <Border Style="{StaticResource SubPanel}" Margin="0,16,0,0" Padding="14,10">
                                <TextBlock x:Name="color" Text="{ui:Loc Host.ColorAndEncryption}" Style="{StaticResource Overview}" FontSize="12" Margin="0" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Settings Content -->
                <StackPanel x:Name="SettingsContent" Visibility="Collapsed">
                    <Border Style="{StaticResource HostCard}">
                        <DockPanel>
                            <ComboBox x:Name="languageSelector" DockPanel.Dock="Right" MinWidth="170" VerticalAlignment="Center" Padding="8,6"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Code" ToolTip="{ui:Loc Common.LanguageHint}" />
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{ui:Loc Host.LanguageSection}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{ui:Loc Host.LanguageOverview}" Style="{StaticResource Overview}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource HostCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Border DockPanel.Dock="Right" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="displayOverview" Text="{ui:Loc Host.PrimaryDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" />
                                </Border>
                                <TextBlock Text="{ui:Loc Host.SharingSettings}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <local:HostDisplaySettings x:Name="displaySettings" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="loginSection" Style="{StaticResource HostCard}">
                        <DockPanel>
                            <Button x:Name="openLogin" DockPanel.Dock="Right" Content="{ui:Loc Common.OpenSettings}" VerticalAlignment="Center" MinWidth="104" AutomationProperties.Name="打开登录设置" />
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{ui:Loc Host.LoginSettings}" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="loginOverview" Text="{ui:Loc Host.LoadingLoginSettings}" Style="{StaticResource Overview}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border x:Name="serviceSection" Style="{StaticResource HostCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Border DockPanel.Dock="Right" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="serviceOverview" Text="{ui:Loc Host.CheckingSystemService}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                                </Border>
                                <TextBlock Text="{ui:Loc Host.SystemService}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <local:ServiceSettingsView x:Name="serviceSettings" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource HostCard}">
                        <DockPanel>
                            <Button x:Name="openDevices" DockPanel.Dock="Right" Content="{ui:Loc Common.OpenSettings}" VerticalAlignment="Center" MinWidth="104" AutomationProperties.Name="打开受信任的设备" />
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{ui:Loc Host.TrustedDevices}" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="deviceOverview" Text="{ui:Loc Host.LoadingDevices}" Style="{StaticResource Overview}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource HostCard}">
                        <DockPanel>
                            <Button x:Name="openLogs" DockPanel.Dock="Right" Content="{ui:Loc Common.View}" VerticalAlignment="Center" MinWidth="104" AutomationProperties.Name="打开诊断与日志" />
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{ui:Loc Host.DiagnosticsAndLogs}" Style="{StaticResource SectionTitle}" Margin="0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
