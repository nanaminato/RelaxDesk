<UserControl x:Class="RelaxDesk.HostShell.ServiceSettingsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="服务状态" FontSize="17" FontWeight="SemiBold" />
        <TextBlock x:Name="Installation" Text="尚未检查服务安装状态。" TextWrapping="Wrap" Margin="0,8,0,0" />
        <CheckBox x:Name="UseService" Content="使用系统服务协调（不增加桌面权限）" Margin="0,12,0,4" />
        <WrapPanel>
            <Button x:Name="ConnectService" Content="连接系统服务" IsEnabled="False" />
            <Button x:Name="RefreshService" Content="刷新服务状态" />
        </WrapPanel>
        <Separator Margin="0,14" />
        <TextBlock Text="启动设置" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox x:Name="Startup" SelectedIndex="0" MinWidth="240" HorizontalAlignment="Left">
            <ComboBoxItem Content="保留启动设置（首次安装为手动）" />
            <ComboBoxItem Content="手动启动服务" />
            <ComboBoxItem Content="开机自动启动服务" />
        </ComboBox>
        <WrapPanel>
            <Button x:Name="InstallService" Content="安装／更新／修复（管理员）" />
            <Button x:Name="UninstallService" Content="卸载服务（管理员）" />
        </WrapPanel>
        <TextBlock x:Name="Progress" TextWrapping="Wrap" Margin="0,12,0,0" />
    </StackPanel>
</UserControl>
